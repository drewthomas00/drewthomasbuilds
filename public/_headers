# Fonts are content-addressed by name and never change in place — cache them hard.
# This is the whole point of splitting them out of the HTML.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Stylesheets DO change in place, so they get a short life and must-revalidate
# rather than the fonts' immutable. A palette edit has to reach people who have
# already visited; an hour is the most staleness worth trading for the cache hit.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800

/drew-thomas-resume.pdf
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
